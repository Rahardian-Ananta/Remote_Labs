# Dockerfile for RemoteLab Executor
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies including OpenMPI for MPI support
RUN apt-get update && apt-get install -y --no-install-recommends \
    openmpi-bin \
    libopenmpi-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (mpi4py will link against system OpenMPI)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY common/ common/
COPY executor/ executor/
COPY examples/ examples/

# Create non-root user for sandbox safety
RUN useradd -m -u 1000 remotelab && chown -R remotelab:remotelab /app
USER remotelab

# Health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:9001/health || exit 1

EXPOSE 9001

CMD ["python", "-m", "uvicorn", "executor.main:app", "--host", "0.0.0.0", "--port", "9001", "--log-level", "info"]

