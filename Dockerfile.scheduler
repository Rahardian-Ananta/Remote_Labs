# Dockerfile for RemoteLab Scheduler
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (without mpi4py which needs MPI runtime)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY common/ common/
COPY scheduler/ scheduler/

# Create non-root user
RUN useradd -m -u 1000 remotelab && chown -R remotelab:remotelab /app
USER remotelab

# Health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "scheduler.main:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "info"]

